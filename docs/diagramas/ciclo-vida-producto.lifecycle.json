      "label": "DELETE → 204",
      "note": "sin cuerpo",
      "route": "straight",
      "labelDy": -40
    },
    {
      "id": "siguiente",
      "from": "borrado",
      "to": "nuevo_ciclo",
      "label": "POST otra vez",
      "note": "el id no se recicla",
      "route": "straight",
      "labelDy": -40
    },
    {
      "id": "datos-invalidos",
      "from": "actualizado",
      "to": "rechazado",
      "label": "datos inválidos → 400",
      "note": "mismas reglas al crear (POST)",
      "variant": "dashed",
      "labelAt": [230, 233]
    },
    {
      "id": "reintentar",
      "from": "rechazado",
      "to": "actualizado",
      "label": "reintentar",
      "variant": "dashed",
      "labelAt": [482, 245]
    },
    {
      "id": "id-fantasma",
      "from": "borrado",
      "to": "no_encontrado",
      "label": "repetido → 404",
      "note": "ese id ya no existe",
      "variant": "dashed",
      "labelDy": 24
    }
  ],
  "cards": [
    {
      "dot": "cyan",
      "title": "El riel principal",
      "items": [
        "POST crea la fila y responde 201 con el id",
        "PUT reemplaza los datos y responde 200",
        "DELETE la saca y responde 204 sin cuerpo"
      ]
    },
    {
      "dot": "rose",
      "title": "Los dos rechazos",
      "items": [
        "400: los datos no cumplen las reglas (al crear o editar)",
        "404: el id no existe — también si ya fue borrado",
        "Ninguno altera la base: solo informan"
      ]
    },
    {
      "dot": "amber",
      "title": "Para probar a mano",
      "items": [
        "Borrá dos veces el mismo producto: la segunda da 404",
        "Después de borrar, cargá otro: el id NO se recicla",
        "Precio 0 por curl: llega el 400 con la lista de errores"
      ]
    }
  ]
}
