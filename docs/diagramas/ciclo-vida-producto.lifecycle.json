      },
      {
        "id": "intentos-fallidos",
        "label": "Intentos fallidos",
        "focus": ["rechazado", "no_encontrado"],
        "note": "Los dos errores que puede devolver la API y por qué ninguno modifica la base."
      }
    ]
  },
  "lanes": [
